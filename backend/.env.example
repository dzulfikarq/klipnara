# Optional executable/model overrides. Keep local model files outside source control.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
WHISPER_CPP_PATH=whisper-cli
WHISPER_MODEL_PATH=C:/tools/whisper.cpp/models/ggml-small.bin
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT_SECONDS=600
AI_REQUEST_TIMEOUT_SECONDS=180

# Persistent app data root (database, work, mood, clips, and sources).
# CLIPPER_DATA_DIR=G:/Klipnara
# Optional media roots; defaults are under CLIPPER_DATA_DIR.
# CLIPPER_SOURCE_DIR=G:/Klipnara/sources
# CLIPPER_CLIP_DIR=G:/Klipnara/clips

# Cloud is disabled until a provider is selected per job. Keys stay in environment.
# Optional subtitle transcription/translation: OpenAI uploads composition audio only after consent; translation sends text.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Gemini subtitle STT requests word timing/speakers (max 30 min); composition audio uploads only after consent.
# Alternative: GEMINI_MODEL=gemini-3.6-flash

# Optional YouTube Clip metadata key. Restrict Google Cloud key to YouTube Data API v3.
# IFrame preview works without this key; this key does not enable media import.
# YOUTUBE_DATA_API_KEY=

# Optional social OAuth. Leave blank to keep API upload disabled; manual export still works.
# TikTok Inbox transfer requests user.info.basic + video.upload only; never video.publish/Direct Post.
# Register exact HTTPS callback in TikTok developer app; forward local TLS listener to FastAPI.
# Klipnara does not configure TLS or create a public tunnel.
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# TIKTOK_REDIRECT_URI=https://localhost:8443/api/platforms/tiktok/oauth/callback
# Meta uses Facebook Login for Business and linked Instagram Professional accounts.
# Local resumable upload is not Instagram Login's public video_url flow.
# META_APP_ID=
# META_APP_SECRET=
# META_LOGIN_CONFIG_ID=
# META_REDIRECT_URI=http://localhost:8000/api/platforms/instagram/oauth/callback
# META_GRAPH_API_VERSION=v26.0

# Optional official stock-footage search. Key stays backend-only; never use NEXT_PUBLIC_*.
# PEXELS_API_KEY=

# Optional local YouTube segment adapter. Disabled by default; yt-dlp is not official YouTube tooling.
# Enable only when acquisition/use is allowed by rights and applicable platform terms. No cookies or bypasses.
YOUTUBE_IMPORT_ENABLED=0
YT_DLP_PATH=yt-dlp

# Optional YouTube publishing OAuth web client. Never commit real credentials.
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REDIRECT_URI=http://localhost:8000/api/youtube/oauth/callback
# YOUTUBE_FRONTEND_URL=http://localhost:3000/accounts
