# Optional executable/model overrides. Keep local model files outside source control.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
WHISPER_CPP_PATH=whisper-cli
WHISPER_MODEL_PATH=C:/tools/whisper.cpp/models/ggml-small.bin
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT_SECONDS=600
AI_REQUEST_TIMEOUT_SECONDS=180

# Optional media roots; database and temp files remain under CLIPPER_DATA_DIR.
# CLIPPER_SOURCE_DIR=G:/Klipnara/sources
# CLIPPER_CLIP_DIR=G:/Klipnara/clips

# Cloud is disabled until a provider is selected per job. Keys stay in environment.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Alternative: GEMINI_MODEL=gemini-3.6-flash

# Optional YouTube Data API v3 OAuth web client. Never commit real credentials.
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REDIRECT_URI=http://localhost:8000/api/youtube/oauth/callback
# YOUTUBE_FRONTEND_URL=http://localhost:3000/accounts
